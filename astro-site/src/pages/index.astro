---
import BaseLayout from '../layouts/BaseLayout.astro';
import team from '../data/team.json';
import publications from '../data/publications.json';

const base = import.meta.env.BASE_URL;
const recentPubs = publications.filter(p => typeof p.year === 'number').sort((a, b) => b.year - a.year).slice(0, 7);
const researchAreas = [
  { num: '01', icon: '🤝', title: 'Intelligent Information Sharing', desc: 'Modeling information-sharing, team cognition, and workload to create synergistic human–machine partnerships across complex, high-stakes environments.' },
  { num: '02', icon: '🔒', title: 'Trustworthy AI', desc: 'Designing transparent AI behaviors that accurately calibrate trust, support responsible AI adoption, and contribute to meaningful AI acceptance.' },
  { num: '03', icon: '📚', title: 'Training', desc: 'Improving skill transference from training to operations through intelligent interventions, human-centered design, and psychological fidelity.' },
  { num: '04', icon: '🎯', title: 'Situational Awareness', desc: 'Developing real-time adaptive interfaces that surface mission-critical cues and promote collective understanding in electronically contested environments.' },
  { num: '05', icon: '🤖', title: 'Applied Robotics', desc: 'Integrating collaborative robots and unmanned ground vehicles into advanced manufacturing workflows and high-stakes emergency response scenarios.' },
  { num: '06', icon: '🔬', title: 'Evaluation & Validation', desc: 'Developing rigorous experimental frameworks to test AI teammates\' effectiveness, safety, and resilience through mixed-methods empirical research.' },
];
---
<BaseLayout title="ARCS Lab | AI & Robotics for Collaborative Systems | UTK" activePage="home">
<style>
  .hero {
    min-height: 70vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-top: var(--nav-h);
  }
  .hero-left {
    padding: 80px 64px 80px 80px;
    display: flex; flex-direction: column; justify-content: center;
  }
  .hero-eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--utk-orange); margin-bottom: 24px;
    display: flex; align-items: center; gap: 12px;
    animation: fadeUp 0.6s ease both;
  }
  .hero-eyebrow::after {
    content: ''; flex: 1; max-width: 48px; height: 1px;
    background: var(--utk-orange);
  }
  .hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(42px, 5vw, 68px);
    font-weight: 900; line-height: 1.05;
    color: var(--stone-900); margin-bottom: 24px;
    animation: fadeUp 0.7s 0.1s ease both;
  }
  .hero-title span { color: var(--utk-orange); }
  .hero-desc {
    font-size: 17px; line-height: 1.75; color: var(--smoke);
    max-width: 480px; margin-bottom: 48px;
    animation: fadeUp 0.7s 0.2s ease both;
  }
  .hero-stats {
    display: flex; gap: 40px; margin-bottom: 48px;
    padding-top: 40px;
    border-top: 1px solid var(--stone-200);
    animation: fadeUp 0.7s 0.3s ease both;
  }
  .stat-num {
    font-family: 'Playfair Display', serif;
    font-size: 36px; font-weight: 700;
    color: var(--stone-900); line-height: 1;
  }
  .stat-num span { color: var(--utk-orange); }
  .stat-label {
    font-size: 12px; color: var(--smoke); margin-top: 4px;
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  .hero-actions { display: flex; gap: 16px; flex-wrap: wrap; animation: fadeUp 0.7s 0.4s ease both; }
  .hero-right {
    position: relative; overflow: hidden;
  }
  .hero-right img {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover; display: block;
    object-position: 33% 67%;
  }

  .mission-strip {
    background: var(--utk-orange);
    padding: 40px 80px;
    display: flex; align-items: center; gap: 40px;
  }
  .mission-strip-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase;
    color: rgba(255,255,255,0.90); white-space: nowrap;
  }
  .mission-strip-divider { width: 1px; height: 40px; background: rgba(255,255,255,0.88); }
  .mission-strip-text {
    font-family: 'Playfair Display', serif;
    font-size: 20px; font-style: italic;
    color: white; line-height: 1.5;
  }

  section.research { padding: 100px 80px; background: var(--stone-100); }
  .research-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .research-card {
    background: white; padding: 36px 32px;
    border: 1px solid var(--stone-200);
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative; overflow: hidden; cursor: default;
  }
  .research-card::before {
    content: ''; position: absolute; top: 0; left: 0;
    width: 100%; height: 4px; background: var(--stone-200); transition: background 0.3s;
  }
  .research-card:hover::before { background: var(--utk-orange); }
  .research-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 48px rgba(30,21,13,0.10), 0 4px 12px rgba(30,21,13,0.06);
    border-color: transparent;
  }
  .rc-header { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; }
  .rc-num {
    font-family: 'DM Mono', monospace; font-size: 11px; color: white;
    background: var(--stone-900); width: 32px; height: 32px;
    display: flex; align-items: center; justify-content: center;
    letter-spacing: 0.05em; flex-shrink: 0;
  }
  .research-card:hover .rc-num { background: var(--utk-orange); }
  .rc-icon {
    width: 48px; height: 48px; background: var(--stone-100);
    display: flex; align-items: center; justify-content: center;
    font-size: 22px; transition: all 0.3s; flex-shrink: 0;
  }
  .research-card:hover .rc-icon { background: rgba(255,102,0,0.1); transform: scale(1.05); }
  .rc-title { font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700; color: var(--stone-900); margin-bottom: 12px; line-height: 1.25; }
  .rc-desc { font-size: 14px; color: var(--smoke); line-height: 1.75; }
  .rc-arrow {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: 'DM Mono', monospace; font-size: 11px; letter-spacing: 0.08em;
    color: var(--stone-500); margin-top: 20px; text-transform: uppercase;
    transition: color 0.2s;
  }
  .research-card:hover .rc-arrow { color: var(--utk-orange); }
  .rc-arrow span { transition: transform 0.2s; display: inline-block; }
  .research-card:hover .rc-arrow span { transform: translateX(4px); }

  section.pubs-section { background: var(--stone-900); color: white; padding: 100px 80px; }
  .pubs-section .section-title { color: white; }
  .pubs-section .section-lead { color: rgba(255,255,255,0.93); }
  .pub-list { display: flex; flex-direction: column; }
  .pub-item {
    padding: 28px 0; border-bottom: 1px solid rgba(255,255,255,0.08);
    display: grid; grid-template-columns: 80px 1fr auto;
    gap: 24px; align-items: start; transition: all 0.2s;
  }
  .pub-item:hover { padding-left: 8px; }
  .pub-item:last-child { border-bottom: none; }
  .pub-year { font-family: 'DM Mono', monospace; font-size: 12px; color: var(--utk-orange); padding-top: 4px; }
  .pub-title-text { font-size: 15px; font-weight: 500; color: rgba(255,255,255,0.9); line-height: 1.5; margin-bottom: 6px; }
  .pub-meta { font-size: 12px; color: rgba(255,255,255,0.90); font-style: italic; }
  .pub-award { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 0.08em; color: var(--utk-orange); background: rgba(255,102,0,0.12); padding: 3px 8px; white-space: nowrap; height: fit-content; }
  .pubs-cta { margin-top: 48px; }

  section.team-section { background: var(--stone-100); padding: 100px 80px; }
  .team-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 24px; margin-bottom: 48px;
  }
  .team-card { background: white; overflow: hidden; transition: transform 0.2s, box-shadow 0.2s; }
  .team-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(30,21,13,0.12); }
  .team-card-img { height: 420px; background: var(--stone-200); overflow: hidden; }
  .team-card-img img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; display: block; }
  .team-card-body { padding: 24px; }
  .team-card-name { font-family: 'Playfair Display', serif; font-size: 18px; font-weight: 700; color: var(--stone-900); margin-bottom: 4px; }
  .team-card-role { font-size: 12px; color: var(--utk-orange); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 8px; }
  .team-card-desc { font-size: 13px; color: var(--smoke); line-height: 1.6; }

  .funding-strip {
    background: white; padding: 60px 80px;
    display: flex; align-items: center; gap: 64px; flex-wrap: wrap;
  }
  .funding-label { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--stone-500); white-space: nowrap; }
  .funding-logo-row { display: flex; align-items: center; gap: 48px; flex-wrap: wrap; }
  .funding-logo { display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .funding-logo-badge { padding: 12px 24px; border: 1.5px solid var(--stone-200); font-weight: 700; font-size: 14px; color: var(--stone-700); letter-spacing: 0.02em; }
  .funding-logo-sub { font-size: 10px; color: var(--stone-500); text-transform: uppercase; letter-spacing: 0.1em; }
  .funding-amount { margin-left: auto; text-align: right; }
  .funding-amount-num { font-family: 'Playfair Display', serif; font-size: 42px; font-weight: 900; color: var(--stone-900); line-height: 1; }
  .funding-amount-label { font-size: 11px; color: var(--smoke); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 4px; }

  .contact-strip {
    background: var(--stone-900); padding: 80px;
    display: grid; grid-template-columns: 1fr 1fr; gap: 80px;
  }
  .contact-strip .section-title { color: white; font-size: 32px; }
  .contact-strip .section-lead { color: rgba(255,255,255,0.92); font-size: 15px; }
  .contact-info { display: flex; flex-direction: column; gap: 20px; }
  .contact-item { display: flex; gap: 16px; align-items: flex-start; }
  .contact-icon { width: 36px; height: 36px; background: rgba(255,102,0,0.15); display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; color: var(--utk-orange); }
  .contact-item-label { font-size: 11px; color: rgba(255,255,255,0.90); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 4px; }
  .contact-item-val { font-size: 14px; color: rgba(255,255,255,0.85); }
  .contact-item-val a { color: var(--utk-orange); text-decoration: none; }

  @media (max-width: 1024px) {
    .hero { grid-template-columns: 1fr; }
    .hero-right { display: none; }
    .hero-left { padding: 60px 40px; }
    section.research, section.pubs-section, section.team-section { padding: 60px 40px; }
    .research-grid { grid-template-columns: 1fr 1fr; }
    section.research::before { font-size: 120px; }
    .team-grid { grid-template-columns: 1fr 1fr; }
    .contact-strip { grid-template-columns: 1fr; gap: 40px; padding: 60px 40px; }
    .mission-strip { padding: 32px 40px; }
    .funding-strip { padding: 40px; }
  }
</style>

<!-- HERO -->
<section class="hero" style="padding: var(--nav-h) 0 0;">
  <div class="hero-left">
    <div class="hero-eyebrow">Tickle College of Engineering · UTK ISE</div>
    <h1 class="hero-title">
      AI &amp; Robotics for<br>
      <span>Collaborative</span><br>
      Systems Lab
    </h1>
    <p class="hero-desc">
      Advancing the science and engineering of human‑AI teaming through rigorous, human‑centered research — designing trustworthy AI teammates for defense, manufacturing, healthcare, and beyond.
    </p>
    <div class="hero-stats">
      <div>
        <div class="stat-num">46<span>+</span></div>
        <div class="stat-label">Publications</div>
      </div>
      <div>
        <div class="stat-num">5</div>
        <div class="stat-label">Best Paper Awards</div>
      </div>
    </div>
    <div class="hero-actions">
      <a href={`${base}/research`} class="btn-primary">Explore Our Research</a>
      <a href={`${base}/publications`} class="btn-outline">View Publications</a>
    </div>
  </div>
  <div class="hero-right">
    <img src="/ARCSLab/assets/downtownPic.jpg" alt="Knoxville skyline" />
  </div>
</section>

<!-- MISSION STRIP -->
<div class="mission-strip">
  <span class="mission-strip-label">Mission</span>
  <div class="mission-strip-divider"></div>
  <p class="mission-strip-text">
    "Advancing human‑AI teaming by understanding and optimizing collaborative systems comprising both human and computational elements to enhance performance and safety across manufacturing, healthcare, defense, and beyond."
  </p>
</div>

<!-- RESEARCH AREAS -->
<section class="research">
  <div class="section-eyebrow">Core Research Areas</div>
  <h2 class="section-title">Six Pillars of Human-AI<br>Teaming Research</h2>
  <p class="section-lead">Our interdisciplinary program integrates quantitative, qualitative, and computational methods to understand and improve human-AI collaborative systems.</p>
  <div class="research-grid">
    {researchAreas.map(area => (
      <a href={`${base}/research`} class="research-card" style="text-decoration:none;">
        <div class="rc-header">
          <div class="rc-num">{area.num}</div>
          <div class="rc-icon">{area.icon}</div>
        </div>
        <div class="rc-title">{area.title}</div>
        <p class="rc-desc">{area.desc}</p>
        <div class="rc-arrow">Learn more <span>→</span></div>
      </a>
    ))}
  </div>
</section>

<!-- RECENT PUBLICATIONS -->
<section class="pubs-section">
  <div class="section-eyebrow">Latest Work</div>
  <h2 class="section-title">Recent Publications</h2>
  <p class="section-lead">Published across leading venues in Human Factors, HCI, ACM, and IEEE.</p>
  <div class="pub-list">
    {recentPubs.map(pub => (
      <div class="pub-item">
        <span class="pub-year">{pub.year}</span>
        <div>
          <div class="pub-title-text">{pub.title}</div>
          <div class="pub-meta" set:html={`${pub.authors.replace(/Schelble/g, '<strong style="color:rgba(255,255,255,0.90)">Schelble</strong>')} · <em>${pub.venue}</em>`} />
        </div>
        {pub.award ? <span class="pub-award">★ {pub.award}</span> : <span></span>}
      </div>
    ))}
  </div>
  <div class="pubs-cta">
    <a href={`${base}/publications`} class="btn-primary">View All {publications.length} Publications →</a>
  </div>
</section>

<!-- TEAM PREVIEW -->
<section class="team-section">
  <div class="section-eyebrow">The Team</div>
  <h2 class="section-title">Meet the ARCS Lab</h2>
  <p class="section-lead">A growing community of researchers advancing the science of human-AI collaboration at the University of Tennessee, Knoxville.</p>
  <div class="team-grid">
    <div class="team-card">
      <div class="team-card-img">
        <img src={`${base}/${team.pi.photo}`} alt={team.pi.name} style={`object-position: ${team.pi.cropPosition || 'center 20%'}`}>
      </div>
      <div class="team-card-body">
        <div class="team-card-name">{team.pi.name}</div>
        <div class="team-card-role">PI · Founding Director</div>
        <div class="team-card-desc">{team.pi.shortBio}</div>
      </div>
    </div>
    {team.phdStudents.map(s => (
      <div class="team-card">
      <div class="team-card-img">
          <img src={`${base}/${s.photo}`} alt={s.name} style={`object-position: ${s.cropPosition || 'center 20%'}`}>
        </div>
        <div class="team-card-body">
          <div class="team-card-name">{s.name}</div>
          <div class="team-card-role">PhD Student</div>
          <div class="team-card-desc">{s.shortBio}</div>
        </div>
      </div>
    ))}
    <div class="team-card">
      <div class="team-card-img" style="background: var(--stone-900); display:flex; align-items:center; justify-content:center;">
        <div style="text-align:center; padding: 20px;">
          <div style="font-family:'Playfair Display',serif; font-size:40px; color:var(--utk-orange); font-weight:900;">+</div>
          <div style="font-size:13px; color:rgba(255,255,255,0.92); margin-top:8px;">Recruiting<br>Graduate Students</div>
        </div>
      </div>
      <div class="team-card-body">
        <div class="team-card-name">Join the ARCS Lab</div>
        <div class="team-card-role">Open Positions</div>
        <div class="team-card-desc">We seek motivated PhD students in ISE, CS, HCI, and Psychology. Email Dr. Schelble with your CV.</div>
      </div>
    </div>
  </div>
  <a href={`${base}/team`} class="btn-outline">View Full Team →</a>
</section>

<!-- FUNDING STRIP -->
<div class="funding-strip">
  <span class="funding-label">Funding &amp; Partners</span>
  <div class="funding-logo-row">
    <div class="funding-logo">
      <div class="funding-logo-badge">ARL</div>
      <div class="funding-logo-sub">Army Research Lab</div>
    </div>
    <div class="funding-logo">
      <div class="funding-logo-badge">UTK</div>
      <div class="funding-logo-sub">University of Tennessee</div>
    </div>
  </div>
  <div class="funding-amount">
    <div class="funding-amount-num">$722K</div>
    <div class="funding-amount-label">Total PI Awards</div>
  </div>
</div>

<!-- CONTACT STRIP -->
<div class="contact-strip">
  <div>
    <div class="section-eyebrow">Get in Touch</div>
    <h2 class="section-title">Work With Us</h2>
    <p class="section-lead">Interested in collaboration, graduate study, or partnership? We'd love to hear from you.</p>
    <div style="margin-top: 32px; display:flex; gap:16px; flex-wrap:wrap;">
      <a href={`${base}/contact`} class="btn-primary">Contact the Lab</a>
      <a href={`${base}/team#join`} class="btn-outline" style="border-color:rgba(255,255,255,0.2); color:rgba(255,255,255,0.90);">Prospective Students</a>
    </div>
  </div>
  <div class="contact-info">
    <div class="contact-item">
      <div class="contact-icon">📍</div>
      <div>
        <div class="contact-item-label">Location</div>
        <div class="contact-item-val">515 John D. Tickle Engineering Building<br>851 Neyland Drive, Knoxville, TN 37996</div>
      </div>
    </div>
    <div class="contact-item">
      <div class="contact-icon">✉️</div>
      <div>
        <div class="contact-item-label">Email</div>
        <div class="contact-item-val"><a href="mailto:bschelbl@utk.edu">bschelbl@utk.edu</a></div>
      </div>
    </div>
    <div class="contact-item">
      <div class="contact-icon">🏛</div>
      <div>
        <div class="contact-item-label">Department</div>
        <div class="contact-item-val">Industrial &amp; Systems Engineering<br>Tickle College of Engineering, UTK</div>
      </div>
    </div>
    <div class="contact-item">
      <div class="contact-icon">🔗</div>
      <div>
        <div class="contact-item-label">Lab Website</div>
        <div class="contact-item-val"><a href="https://bschelb.github.io/ARCSLab" target="_blank">bschelb.github.io/ARCSLab</a></div>
      </div>
    </div>
  </div>
</div>
</BaseLayout>
