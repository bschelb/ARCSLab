---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import publications from '../data/publications.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const years = [...new Set(publications.filter(p => typeof p.year === 'number').map(p => p.year))].sort((a, b) => b - a);
const journalCount = publications.filter(p => p.type === 'journal').length;
const confCount = publications.filter(p => p.type === 'conference').length;
const bookCount = publications.filter(p => p.type === 'book chapter').length;
const awardCount = publications.filter(p => p.award && p.award !== 'In Press').length;
const highlightSchelble = (authors: string) =>
  authors.replace(/Schelble, B\.G\./g, '<strong>Schelble, B.G.</strong>').replace(/Schelble(?![^<]*<\/strong>)/g, '<strong>Schelble</strong>');
---
<BaseLayout title="Publications | ARCS Lab | UT Knoxville" activePage="publications"
  description={`${publications.length}+ peer-reviewed publications from the ARCS Lab on human-AI teaming, trust in AI, and collaborative systems.`}>
  <Breadcrumb slot="head" trail={[['Home', '/'], ['Publications', '/publications']]} />
<style>
  .filter-bar {
    position: sticky; top: calc(var(--nav-h) + 3px); z-index: 50;
    display: flex; gap: 10px; align-items: center; flex-wrap: wrap;
    padding: 20px var(--gutter);
    background: rgba(250, 248, 243, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .filter-bar .fl {
    font-family: var(--mono); font-size: 10.5px; font-weight: 500;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--text-muted); margin-right: 10px;
  }
  .filter-btn {
    padding: 8px 18px; font-family: var(--mono); font-size: 11px;
    font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase;
    border: 1px solid var(--line-strong); background: transparent;
    color: var(--text); cursor: pointer; transition: all 0.2s;
  }
  .filter-btn:hover { border-color: var(--orange); color: var(--orange-deep); }
  .filter-btn.active { background: var(--ink); color: #fff; border-color: var(--ink); }

  .pub-list { padding: 24px var(--gutter) 100px; }
  .year-group { margin-top: 56px; }
  .year-head { display: flex; align-items: baseline; gap: 18px; margin-bottom: 8px; }
  .year-label {
    font-family: var(--serif); font-size: 40px; font-weight: 600;
    color: var(--text-strong); line-height: 1;
  }
  .year-rule { flex: 1; height: 1px; background: var(--line); position: relative; top: -6px; }
  .year-count {
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em;
    color: var(--text-muted); white-space: nowrap; position: relative; top: -6px;
  }
  .pub-row {
    display: grid; grid-template-columns: 110px 1fr auto; gap: 24px;
    padding: 22px 0; border-bottom: 1px solid var(--line); align-items: start;
    position: relative; transition: padding-left 0.22s ease;
    text-decoration: none; color: inherit;
  }
  .pub-row::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    width: 2px; background: var(--orange); opacity: 0; transition: opacity 0.22s;
  }
  .pub-row:hover { padding-left: 16px; }
  .pub-row:hover::before { opacity: 1; }
  .pub-row:hover .pub-title-text { color: var(--orange-deep); }
  .pub-type {
    font-family: var(--mono); font-size: 9.5px; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase;
    padding: 4px 10px; height: fit-content; width: fit-content;
    margin-top: 3px; white-space: nowrap;
  }
  .pub-type.journal { color: var(--orange-deep); background: var(--orange-glow); }
  .pub-type.conference { color: var(--text-strong); background: var(--paper-2); border: 1px solid var(--line); }
  .pub-type.book { color: #fff; background: var(--ink); }
  .pub-type.workshop { color: var(--text-muted); border: 1px dashed var(--line-strong); }
  .pub-title-text { font-size: 15.5px; font-weight: 500; color: var(--text-strong); line-height: 1.55; margin-bottom: 5px; }
  .pub-authors { font-size: 13px; color: var(--text); margin-bottom: 3px; }
  .pub-authors :global(strong) { color: var(--text-strong); font-weight: 600; }
  .pub-venue { font-size: 12.5px; color: var(--text-muted); font-style: italic; }
  .pub-aside { display: flex; flex-direction: column; gap: 8px; align-items: flex-end; }
  .pub-award-badge {
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.06em;
    color: var(--orange-deep); background: var(--orange-glow);
    padding: 5px 11px; white-space: nowrap; height: fit-content;
  }
  .pub-pdf-badge {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: var(--mono); font-size: 9.5px; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase; white-space: nowrap;
    color: #fff; background: var(--orange); padding: 4px 9px; height: fit-content;
  }
  .pub-pdf-badge .dotpdf { width: 5px; height: 5px; border-radius: 50%; background: #fff; }
  @media (max-width: 768px) {
    .pub-row { grid-template-columns: 1fr; gap: 10px; }
    .pub-aside { flex-direction: row; align-items: flex-start; }
  }
</style>

<PageHeader
  index="02"
  crumb="Scholarly Output"
  title="What we've"
  titleEm="published."
  lead="A complete record of peer-reviewed journal articles, conference papers, book chapters, and workshop contributions from the ARCS Lab and its collaborators."
  stats={[
    { value: `${publications.length}<span>+</span>`, label: 'Total Publications' },
    { value: `${journalCount}`, label: 'Journal Articles' },
    { value: `${confCount}`, label: 'Conference Papers' },
    { value: `${bookCount}`, label: 'Book Chapters' },
    { value: `${awardCount}`, label: 'Best Paper Awards' },
  ]}
/>

<div class="filter-bar">
  <span class="fl">Filter //</span>
  <button class="filter-btn active" data-filter="all">All</button>
  <button class="filter-btn" data-filter="journal">Journals</button>
  <button class="filter-btn" data-filter="conference">Conference</button>
  <button class="filter-btn" data-filter="book chapter">Book Chapters</button>
  <button class="filter-btn" data-filter="workshop">Workshops</button>
  <button class="filter-btn" data-filter="award">★ Award-Winning</button>
</div>

<div class="pub-list">
  {years.map(year => (
    <div class="year-group" data-year={year}>
      <div class="year-head">
        <div class="year-label">{year}</div>
        <div class="year-rule"></div>
        <div class="year-count">{publications.filter(p => p.year === year).length} works</div>
      </div>
      {publications.filter(p => p.year === year).map(pub => (
        <a class="pub-row" href={`${base}/papers/${pub.id}`} data-type={pub.type} data-award={pub.award && pub.award !== 'In Press' ? 'yes' : 'no'}>
          <div class={`pub-type ${pub.type === 'book chapter' ? 'book' : pub.type}`}>{pub.type === 'book chapter' ? 'Book Ch.' : pub.type}</div>
          <div>
            <div class="pub-title-text">{pub.title}</div>
            <div class="pub-authors" set:html={highlightSchelble(pub.authors)} />
            <div class="pub-venue">{pub.venue}</div>
          </div>
          <div class="pub-aside">
            {pub.award && pub.award !== 'In Press' && <div class="pub-award-badge">★ {pub.award}</div>}
            {pub.pdf && <div class="pub-pdf-badge"><span class="dotpdf"></span> Free PDF</div>}
          </div>
        </a>
      ))}
    </div>
  ))}
  {publications.filter(p => typeof p.year !== 'number').length > 0 && (
    <div class="year-group" data-year="inpress">
      <div class="year-head">
        <div class="year-label">In Press</div>
        <div class="year-rule"></div>
        <div class="year-count">{publications.filter(p => typeof p.year !== 'number').length} works</div>
      </div>
      {publications.filter(p => typeof p.year !== 'number').map(pub => (
        <a class="pub-row" href={`${base}/papers/${pub.id}`} data-type={pub.type} data-award="no">
          <div class={`pub-type ${pub.type === 'book chapter' ? 'book' : pub.type}`}>{pub.type === 'book chapter' ? 'Book Ch.' : pub.type}</div>
          <div>
            <div class="pub-title-text">{pub.title}</div>
            <div class="pub-authors" set:html={highlightSchelble(pub.authors)} />
            <div class="pub-venue">{pub.venue}</div>
          </div>
          <div class="pub-aside">
            {pub.pdf && <div class="pub-pdf-badge"><span class="dotpdf"></span> Free PDF</div>}
          </div>
        </a>
      ))}
    </div>
  )}
</div>

<script>
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = (btn as HTMLElement).dataset.filter;
      document.querySelectorAll('.pub-row').forEach(row => {
        const el = row as HTMLElement;
        if (filter === 'all') { el.style.display = ''; }
        else if (filter === 'award') { el.style.display = el.dataset.award === 'yes' ? '' : 'none'; }
        else { el.style.display = el.dataset.type === filter ? '' : 'none'; }
      });
      document.querySelectorAll('.year-group').forEach(group => {
        const el = group as HTMLElement;
        const visibleRows = el.querySelectorAll('.pub-row:not([style*="display: none"])');
        el.style.display = visibleRows.length > 0 ? '' : 'none';
      });
    });
  });
</script>
</BaseLayout>
