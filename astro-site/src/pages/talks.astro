---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import talksData from '../data/talks.json';

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Talks & News | ARCS Lab | UTK" activePage="talks">
<style>
  .page-header::before { content: 'TALKS'; }
  .talks-sec { padding: 80px; }
  .sh { font-family: 'Playfair Display', serif; font-size: 34px; font-weight: 700; color: var(--stone-900); margin-bottom: 48px; }
  .talk-row { display: grid; grid-template-columns: 100px 1fr auto; gap: 24px; padding: 28px 0; border-bottom: 1px solid var(--stone-200); align-items: start; transition: padding-left 0.2s; }
  .talk-row:hover { padding-left: 8px; }
  .talk-row:last-child { border-bottom: none; }
  .talk-date { font-family: 'DM Mono', monospace; font-size: 11px; color: var(--utk-orange); line-height: 1.5; }
  .talk-title { font-size: 16px; font-weight: 600; color: var(--stone-900); margin-bottom: 6px; line-height: 1.4; }
  .talk-venue { font-size: 13px; color: var(--smoke); margin-bottom: 4px; }
  .talk-loc { font-size: 12px; color: var(--stone-500); }
  .talk-speaker { font-size: 13px; font-weight: 500; color: var(--stone-700); white-space: nowrap; text-align: right; }
  .talk-link { display: inline-block; margin-top: 8px; font-size: 12px; color: var(--utk-orange); text-decoration: none; font-weight: 600; letter-spacing: 0.03em; }
  .talk-link:hover { text-decoration: underline; }

  .media-sec { padding: 80px; background: var(--stone-900); }
  .media-sec .sh { color: white; }
  .media-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .media-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); padding: 32px; }
  .media-icon { font-size: 28px; margin-bottom: 16px; }
  .media-title { font-family: 'Playfair Display', serif; font-size: 17px; font-weight: 700; color: white; margin-bottom: 8px; line-height: 1.3; }
  .media-desc { font-size: 13px; color: rgba(255,255,255,0.90); line-height: 1.65; margin-bottom: 16px; }
  .media-link { font-size: 12px; color: var(--utk-orange); text-decoration: none; font-weight: 600; letter-spacing: 0.04em; }
  .media-link:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .talk-row { grid-template-columns: 80px 1fr; }
    .talk-speaker { display: none; }
    .media-grid { grid-template-columns: 1fr; }
    .talks-sec, .media-sec { padding: 48px 28px; }
  }
</style>

<PageHeader eyebrow="Invited Talks & Visibility" title="Talks & News" description="Dr. Schelble and the ARCS Lab are active contributors to national conversations on human-AI teaming in defense, academia, and industry — with invited presentations at the National Academies, West Point, Carnegie Mellon, and beyond." />

<div class="talks-sec">
  <div class="section-eyebrow">Invited Presentations</div>
  <div class="sh">Invited Talks</div>

  {talksData.invitedTalks.map(talk => (
    <div class="talk-row">
      <div class="talk-date">{talk.date}</div>
      <div>
        <div class="talk-title">{talk.title}</div>
        <div class="talk-venue">{talk.venue}</div>
        <div class="talk-loc">{talk.location}</div>
        {talk.link && <a href={talk.link} target="_blank" class="talk-link">View Event →</a>}
      </div>
      <div class="talk-speaker">{talk.speaker}</div>
    </div>
  ))}
</div>

<div class="media-sec">
  <div class="section-eyebrow">Lab News &amp; Announcements</div>
  <div class="sh">In the News</div>
  <div class="media-grid">
    {talksData.media.map(item => (
      <div class="media-card">
        <div class="media-icon">{item.icon}</div>
        <div class="media-title">{item.title}</div>
        <div class="media-desc">{item.description}</div>
        {item.link && <a href={item.link.startsWith('http') ? item.link : `${base}/${item.link}`} target={item.link.startsWith('http') ? '_blank' : undefined} class="media-link">{item.linkText} →</a>}
      </div>
    ))}
  </div>
</div>
</BaseLayout>
