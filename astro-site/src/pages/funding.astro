---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import funding from '../data/funding.json';

const externalGrants = funding.active.filter(g => !g.funder.startsWith('University of Tennessee'));
const internalGrants = funding.active.filter(g => g.funder.startsWith('University of Tennessee'));
---
<BaseLayout title="Funding | ARCS Lab | UT Knoxville" activePage="funding"
  description="ARCS Lab sponsored research — funded by the Army Research Office and the University of Tennessee, Knoxville, with $722K+ awarded as PI.">
  <Breadcrumb slot="head" trail={[['Home', '/'], ['Funding', '/funding']]} />
<style>
  .grants { padding: 96px var(--gutter) 56px; }
  .grant-card {
    background: #fff; border: 1px solid var(--line);
    padding: 52px clamp(28px, 4vw, 56px); margin-bottom: 26px;
    position: relative;
  }
  .gc-head { display: flex; align-items: center; gap: 16px; margin-bottom: 22px; flex-wrap: wrap; }
  .gc-status {
    font-family: var(--mono); font-size: 10px; font-weight: 500;
    letter-spacing: 0.14em; text-transform: uppercase;
    display: inline-flex; align-items: center; gap: 9px; padding: 6px 14px;
  }
  .gc-active { background: var(--orange-glow); color: var(--orange-deep); }
  .gc-id { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.12em; color: var(--text-muted); }
  .gc-title {
    font-family: var(--serif); font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 600; color: var(--text-strong); margin-bottom: 26px; line-height: 1.3;
    max-width: 860px;
  }
  .gc-meta {
    display: flex; gap: 48px; flex-wrap: wrap; margin-bottom: 26px;
    padding: 20px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .gc-meta-item { display: flex; flex-direction: column; gap: 5px; }
  .gc-meta-label {
    font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--text-muted);
  }
  .gc-meta-val { font-size: 14.5px; font-weight: 500; color: var(--text-strong); }
  .gc-desc { font-size: 14.5px; color: var(--text); line-height: 1.8; max-width: 860px; }

  .internal { padding: 0 var(--gutter) 96px; }
  .int-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .int-card { background: var(--paper-2); padding: 34px; border-left: 3px solid var(--orange); }
  .int-status {
    font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--orange-deep); margin-bottom: 12px;
    display: flex; align-items: center; gap: 8px;
  }
  .int-title { font-size: 15.5px; font-weight: 600; color: var(--text-strong); margin-bottom: 8px; line-height: 1.45; }
  .int-meta { font-size: 13px; color: var(--text-muted); }

  .prior { padding: 96px var(--gutter); }
  .prior p { font-size: 15.5px; color: var(--dk-text-2); line-height: 1.8; max-width: 720px; margin-bottom: 36px; }
  .prior p strong { color: #fff; }
  .prior-agencies { display: flex; gap: 14px; flex-wrap: wrap; }
  .agency-pill {
    padding: 12px 22px; border: 1px solid rgba(255,255,255,0.16);
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.04em;
    color: var(--dk-text-2); transition: border-color 0.2s, color 0.2s;
  }
  .agency-pill:hover { border-color: var(--orange); color: var(--orange); }

  @media (max-width: 900px) {
    .int-grid { grid-template-columns: 1fr; }
    .gc-meta { gap: 28px; }
  }
</style>

<PageHeader
  index="05"
  crumb="Sponsored Research"
  title="Funded to solve"
  titleEm="hard problems."
  lead="The ARCS Lab is actively funded by the Army Research Office and the University of Tennessee, Knoxville — supporting research on the most consequential questions in human-AI teaming."
  stats={[
    { value: funding.totalAwardedAsPI, label: 'Total Awarded as PI' },
    { value: `${funding.active.length}`, label: 'Active Awards' },
    { value: '$2.6M+', label: 'Contributed To (Pre-UTK)' },
  ]}
/>

<div class="grants">
  <div class="eyebrow" data-reveal>Current &amp; Awarded Funding</div>
  <h2 class="sec-title" data-reveal>Active <em>grants</em></h2>

  <div style="margin-top: 40px;">
    {externalGrants.map((g, i) => (
      <div class="grant-card frame" data-reveal>
        <div class="gc-head">
          <span class="gc-status gc-active"><span class="status-dot"></span> Active</span>
          <span class="gc-id">AWARD-{String(i + 1).padStart(2, '0')} // EXTERNAL</span>
        </div>
        <div class="gc-title">{g.title}</div>
        <div class="gc-meta">
          <div class="gc-meta-item"><div class="gc-meta-label">Funder</div><div class="gc-meta-val">{g.funder}</div></div>
          <div class="gc-meta-item"><div class="gc-meta-label">Role</div><div class="gc-meta-val">{g.piRole}</div></div>
          {g.amount && <div class="gc-meta-item"><div class="gc-meta-label">Award</div><div class="gc-meta-val">{g.amount}</div></div>}
        </div>
        <p class="gc-desc">{g.description}</p>
      </div>
    ))}
  </div>
</div>

<div class="internal">
  <div class="int-grid">
    {internalGrants.map((g, i) => (
      <div class="int-card" data-reveal style={`--rd: ${i * 90}ms`}>
        <div class="int-status"><span class="status-dot"></span> Active — Internal</div>
        <div class="int-title">{g.title}</div>
        <div class="int-meta">{g.funder} · {g.piRole}</div>
      </div>
    ))}
  </div>
</div>

<div class="prior blueprint on-dark">
  <div class="eyebrow" data-reveal>Prior Contributions</div>
  <h2 class="sec-title" data-reveal>Funded research <em>before UTK</em></h2>
  <p data-reveal>As a PhD student and research assistant at Clemson University, Dr. Schelble made significant contributions to <strong>over $2.6 million</strong> in externally funded research across multiple federal agencies.</p>
  <div class="prior-agencies" data-reveal>
    {funding.prior.agencies.map(a => (
      <div class="agency-pill">{a}</div>
    ))}
  </div>
</div>
</BaseLayout>
