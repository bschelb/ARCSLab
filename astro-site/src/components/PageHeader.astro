---
// Dark "mission briefing" page header with index, crumb, headline, and
// optional stat readouts. Pass `title` as plain text; wrap a phrase in
// `titleEm` to render it as an italic orange accent after `title`.
interface Stat {
  value: string;
  label: string;
}
interface Props {
  index: string;        // e.g. "01"
  crumb: string;        // e.g. "Research Program"
  title: string;
  titleEm?: string;
  lead: string;
  stats?: Stat[];
}
const { index, crumb, title, titleEm, lead, stats } = Astro.props;
---
<header class="page-head">
  <div class="ph-crumb" data-reveal>
    <span class="ph-index">{index}</span>
    <span class="ph-sep"></span>
    <span>ARCS Lab — {crumb}</span>
  </div>
  <h1 data-reveal style="--rd: 80ms">{title} {titleEm && <em>{titleEm}</em>}</h1>
  <p class="ph-lead" data-reveal style="--rd: 160ms">{lead}</p>
  {stats && stats.length > 0 && (
    <div class="ph-meta" data-reveal style="--rd: 240ms">
      {stats.map((s) => (
        <div class="ph-meta-item">
          <div class="v" set:html={s.value} />
          <div class="k">{s.label}</div>
        </div>
      ))}
    </div>
  )}
</header>
