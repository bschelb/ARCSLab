# Supply-chain hardening (Nov 2026 security review).
# Dependency install scripts (preinstall/postinstall) are how npm worms spread; nothing this
# site needs relies on them (esbuild, fsevents and unrs-resolver ship prebuilt binaries).
# Note: this also skips our own pre*/post* hooks, so `build` and `dev` chain their setup steps
# explicitly in package.json.
ignore-scripts=true
# Never resolve a version published less than 7 days ago when adding or updating packages.
# Lockfile installs (npm ci) are unaffected. Override once with --min-release-age=0 if an
# urgent security fix is newer than that.
min-release-age=7
